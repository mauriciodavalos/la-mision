# Copia este archivo como .env.local y llena los valores de tu proyecto de Supabase.
# PUBLIC_ = expuesto al navegador. Nunca pongas aqui la service_role key.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Herramientas de administracion (/admin/tiendas: importador de tiendas por CSV).
# Ponlo en 1 SOLO en .env.local, para correrlas en tu maquina. NO lo definas en
# Netlify: en el sitio publicado la pagina no debe montar el importador.
PUBLIC_ADMIN=0
