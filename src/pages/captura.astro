---
// Página de captura de visitas. HTML-first: el script cliente (captura-ui) monta
// el formulario config-driven sobre #app y maneja fotos, GPS, cola offline y sync.
import "../styles/captura.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Sin esto, iOS y Android vuelven enlaces de teléfono los números sueltos:
         las claves de sucursal ("No. 1006") y los PIN salen azules y tap-para-llamar. -->
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#123B3A" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- iOS ignora el SVG aquí: necesita PNG, y sin él la app instalada sale con
         una captura de la pantalla en vez de un ícono. -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icono-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icono-32.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>Captura de exhibiciones — La Misión</title>
  </head>
  <body>
    <div id="app" class="bs-root"></div>
    <script>
      import { init } from "../lib/captura-ui";
      void init();

      // Service Worker: hace que la app ABRA sin señal (ver public/sw.js).
      // Se registra después de init para no competir por ancho de banda con el
      // catálogo, y si falla no estorba: la captura funciona igual.
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => undefined);
        });
      }
    </script>
  </body>
</html>
